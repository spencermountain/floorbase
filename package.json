{
  "name": "floorbase",
  "version": "0.0.1",
  "description": "freebase data as a parquet file",
  "license": "MIT",
  "repository": "github:spencermountain/floorbase",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "main": "./src/index.js",
  "sideEffects": false,
  "scripts": {
    "build:prepare": "node scripts/00-prepare/run.js",
    "build:events": "node scripts/01-events/index.js",
    "build:people": "node scripts/02-people/index.js",
    "build:locations": "node scripts/03-locations/index.js",
    "build:wikipedia": "node scripts/04-wikipedia/index.js",
    "build:all": "pnpm build:events && pnpm build:people && pnpm build:locations && pnpm build:wikipedia",
    "scratch": "node scratch.js",
    "watch": "node scratch.js --watch",
    "lint": "eslint ."
  },
  "keywords": [
    "freebase"
  ],
  "dependencies": {
    "hyparquet": "^1.31.2",
    "shelljs": "^0.10.0"
  },
  "devDependencies": {
    "eslint": "10.11.0"
  }
}
